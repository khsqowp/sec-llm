# PostgreSQL password (choose something strong)
POSTGRES_PASSWORD=change_me_secure_password

# Ollama chat model — loaded on your local Ollama instance
# Recommended: uncensored security-focused model
CHAT_MODEL=hf.co/mradermacher/Qwen2.5-Coder-14B-Instruct-Uncensored-GGUF:Q4_K_M

# Optional: Perplexity API for knowledge gap enrichment
# Leave blank to disable gap analysis
PERPLEXITY_API_KEY=

# Optional: Anthropic API for knowledge validation
# Leave blank to disable validation
ANTHROPIC_API_KEY=

# Path to your Obsidian vault (or any markdown note directory)
# macOS iCloud example: /Users/you/Library/Mobile Documents/iCloud~md~obsidian/Documents
# Linux example: /home/you/obsidian-vault
VAULT_PATH=/path/to/your/obsidian/vault

# Docker platform (arm64 for Apple Silicon, amd64 for Intel/Linux)
DOCKER_PLATFORM=linux/arm64
